def ue_direction_rotation(direction : UEVector) : UERotator {
    let yaw = degrees(atan2(float(direction.y), float(direction.x)))
    let pitch = degrees(atan2(float(direction.z), float(length(direction.xy))))
    return ue_rotator(double(pitch), double(yaw), 0.0lf)
}
