// Familiar math names delegate to the existing native operations.

def dot(a, b : UEVector2D) : double {
    return ue_dot(a, b)
}

def length(value : UEVector2D) : double {
    return ue_length(value)
}

def length_sq(value : UEVector2D) : double {
    return ue_length_squared(value)
}

def dot(a, b : UEVector) : double {
    return ue_dot(a, b)
}

def length(value : UEVector) : double {
    return ue_length(value)
}

