    return ue_length_squared(value)
}

def operator . xx(value : UEVector2D) : UEVector2D {
    return ue_vector2d(value.x, value.x)
}

def operator . xy(value : UEVector2D) : UEVector2D {
    return ue_vector2d(value.x, value.y)
}

def operator . xy :=(var value : UEVector2D; replacement : UEVector2D) {
    let component0 = replacement.x
    let component1 = replacement.y
    value.x = component0
    value.y = component1
}

