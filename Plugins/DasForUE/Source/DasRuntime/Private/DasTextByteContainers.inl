// Typed container leaves reuse owned snapshots and the existing size limits.
uint8 StructMapKeyByte(const FDasStructValue& H,const char* Path,int32 Index,das::Context* C){
 FInstancedStruct V=ResolveStructValue(H,C);auto F=StructLeaf(V,Path,C);auto* P=CastField<FMapProperty>(F.Property);auto* K=P?CastField<FByteProperty>(P->KeyProp):nullptr;if(!K || K->Enum)C->throw_error("expected raw byte-key map");FScriptMapHelper M(P,F.Memory);if(Index<0 || Index>=M.Num())C->throw_error("map key index out of range");for(int32 I=0;I<M.GetMaxIndex();++I)if(M.IsValidIndex(I) && Index--==0)return ReadPropertyScalarValue(K,M.GetKeyPtr(I),C);C->throw_error("map key index out of range");return 0;
}
uint8 StructSetElementByte(const FDasStructValue& H,const char* Path,int32 Index,das::Context* C){
 FInstancedStruct V=ResolveStructValue(H,C);auto F=StructLeaf(V,Path,C);auto* P=CastField<FSetProperty>(F.Property);auto* E=P?CastField<FByteProperty>(P->ElementProp):nullptr;if(!E || E->Enum)C->throw_error("expected raw byte set");FScriptSetHelper M(P,F.Memory);if(Index<0 || Index>=M.Num())C->throw_error("set element index out of range");for(int32 I=0;I<M.GetMaxIndex();++I)if(M.IsValidIndex(I) && Index--==0)return ReadPropertyScalarValue(E,M.GetElementPtr(I),C);C->throw_error("set element index out of range");return 0;
}
FDasStructValue StructSetWithByte(const FDasStructValue& H,const char* Path,uint8 Key,bool Present,das::Context* C,das::LineInfoArg* At){
 FInstancedStruct V=ResolveStructValue(H,C);auto F=StructLeaf(V,Path,C);auto* P=CastField<FSetProperty>(F.Property);auto* E=P?CastField<FByteProperty>(P->ElementProp):nullptr;if(!E || E->Enum)C->throw_error("expected raw byte set");FScriptSetHelper M(P,F.Memory);if(Present)M.AddElement(&Key);else M.RemoveElement(&Key);return StoreStructValue(V,C,At);
}
