FDasStructValue NativeReferenceGetstruct(const FDasObjectHandle& H,const char* Path,const char* Name,das::Context* C,das::LineInfoArg* At){auto* O=NativeGameplayObject(H,Path,false,C);auto* P=NativeGameplayProperty(O,Path,Name,false,TEXT("struct"),C);return ReadPropertySnapshot(P,P->ContainerPtrToValuePtr<void>(O),C,At);}
