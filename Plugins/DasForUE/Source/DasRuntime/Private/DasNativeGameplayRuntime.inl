FDasObjectHandle NativeReferenceGetobject(const FDasObjectHandle& H,const char* Path,const char* Name,const char* Expected,das::Context* C){auto* O=NativeGameplayObject(H,Path,false,C);auto* P=CastFieldChecked<FObjectProperty>(NativeGameplayProperty(O,Path,Name,false,TEXT("object"),C));if(P->PropertyClass->GetPathName()!=UTF8_TO_TCHAR(Expected))C->throw_error("native object field type mismatch");return MakeObjectHandle(P->GetObjectPropertyValue_InContainer(O),P->PropertyClass,C);}
void NativeReferenceSetobject(const FDasObjectHandle& H,const char* Path,const char* Name,const char* Expected,const FDasObjectHandle& Value,das::Context* C){auto* O=NativeGameplayObject(H,Path,true,C);auto* P=CastFieldChecked<FObjectProperty>(NativeGameplayProperty(O,Path,Name,true,TEXT("object"),C));auto* V=Value.Token?ResolveObject(Value,C):nullptr;if(P->PropertyClass->GetPathName()!=UTF8_TO_TCHAR(Expected) || (V && !V->IsA(P->PropertyClass)))C->throw_error("native object field type mismatch");P->SetObjectPropertyValue_InContainer(O,V);}
FDasClassHandle NativeReferenceGetclass(const FDasObjectHandle& H,const char* Path,const char* Name,das::Context* C){auto* O=NativeGameplayObject(H,Path,false,C);auto* P=CastFieldChecked<FClassProperty>(NativeGameplayProperty(O,Path,Name,false,TEXT("class"),C));return {MakeObjectHandle(P->GetObjectPropertyValue_InContainer(O),UClass::StaticClass(),C).Token};}
void NativeReferenceSetclass(const FDasObjectHandle& H,const char* Path,const char* Name,FDasClassHandle Value,das::Context* C){auto* O=NativeGameplayObject(H,Path,true,C);auto* P=CastFieldChecked<FClassProperty>(NativeGameplayProperty(O,Path,Name,true,TEXT("class"),C));auto* K=Value.Token?Cast<UClass>(ResolveObject(FDasObjectHandle{Value.Token},C)):nullptr;if((Value.Token && !K) || (K && !K->IsChildOf(P->MetaClass)))C->throw_error("native class field constraint mismatch");P->SetObjectPropertyValue_InContainer(O,K);}
