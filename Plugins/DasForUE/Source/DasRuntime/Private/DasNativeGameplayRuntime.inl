void NativeReferenceSetfloat(const FDasObjectHandle& H,const char* Path,const char* Name,float Value,das::Context* C){auto* O=NativeGameplayObject(H,Path,true,C);auto* P=CastFieldChecked<FFloatProperty>(NativeGameplayProperty(O,Path,Name,true,TEXT("float"),C));if(!FMath::IsFinite(Value))C->throw_error("native numeric field must be finite");if(FString(Path)==TEXT("/Script/Engine.CharacterMovementComponent") && (FString(Name)==TEXT("MaxWalkSpeed") || FString(Name)==TEXT("JumpZVelocity")) && Value<0)C->throw_error("movement speed/jump velocity must be nonnegative");P->SetPropertyValue_InContainer(O,Value);}
