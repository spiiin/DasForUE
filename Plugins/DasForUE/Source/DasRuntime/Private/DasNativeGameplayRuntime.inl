// Generated allowlist is independent of editor-only metadata and is checked in
// both compiler and runtime. No FProperty/UFunction pointer crosses a reload.
UObject* NativeGameplayObject(const FDasObjectHandle& H,const char* ClassPath,bool Write,das::Context* C){
 auto* O=CharacterControlObject<UObject>(H,C,Write);const FString Path=ClassPath?UTF8_TO_TCHAR(ClassPath):TEXT("");auto* Class=FindObject<UClass>(nullptr,*Path);if(!Class || !O->IsA(Class))C->throw_error("native gameplay receiver class mismatch");return O;
}
FProperty* NativeGameplayProperty(UObject* O,const char* ClassPath,const char* Name,bool Write,const TCHAR* Kind,das::Context* C){
 const FString Class=ClassPath?UTF8_TO_TCHAR(ClassPath):TEXT(""),Field=Name?UTF8_TO_TCHAR(Name):TEXT("");if(Field.IsEmpty() || Field.Len()>=NAME_SIZE)C->throw_error("invalid native field name");const auto* Entry=DasNativeGameplayField(Class,Field);if(!Entry || FString(Entry->Kind)!=Kind || (Write && Entry->ReadOnly))C->throw_error("native field is not generated or is readonly");
 auto* P=ResolveProperty<FProperty>(O,Name,Write,C);FString Shape;AppendCallShape(P,Shape);if(Shape!=Entry->Signature || P->GetOwnerClass()->GetPathName()!=Entry->Declaring || P->HasAnyPropertyFlags(CPF_Deprecated|CPF_EditorOnly) || P->HasSetterOrGetter() || P->HasAnyPropertyFlags(CPF_BlueprintReadOnly)!=Entry->ReadOnly)C->throw_error("native field shape/policy changed; regenerate bindings");return P;
}
FDasCallHandle BeginNativeGameplayCall(const FDasObjectHandle& H,const char* ClassPath,const char* Name,das::Context* C){
 auto* O=NativeGameplayObject(H,ClassPath,true,C);const FString Class=ClassPath?UTF8_TO_TCHAR(ClassPath):TEXT(""),Method=Name?UTF8_TO_TCHAR(Name):TEXT("");if(Method.IsEmpty() || Method.Len()>=NAME_SIZE)C->throw_error("invalid native method name");const auto* Entry=DasNativeGameplayMethod(Class,Method);auto* F=Entry?O->FindFunction(*Method):nullptr;
 if(!F || !F->HasAnyFunctionFlags(FUNC_BlueprintCallable) || F->HasAnyFunctionFlags(FUNC_Net|FUNC_Static|FUNC_Delegate|FUNC_MulticastDelegate|FUNC_EditorOnly) || CallSignatureKey(F)!=Entry->Signature)C->throw_error("native method missing or shape/policy changed; regenerate bindings");if(F->HasAnyFunctionFlags(FUNC_BlueprintAuthorityOnly)){auto* A=Cast<AActor>(O);if(!A)if(auto* Component=Cast<UActorComponent>(O))A=Component->GetOwner();if(A && !A->HasAuthority())C->throw_error("native method requires authority");}return BeginCall(H,Name,C);
}
int32 NativeReferenceGetint(const FDasObjectHandle& H,const char* Path,const char* Name,das::Context* C){auto* O=NativeGameplayObject(H,Path,false,C);auto* P=CastFieldChecked<FIntProperty>(NativeGameplayProperty(O,Path,Name,false,TEXT("int"),C));return P->GetPropertyValue_InContainer(O);}
void NativeReferenceSetint(const FDasObjectHandle& H,const char* Path,const char* Name,int32 Value,das::Context* C){auto* O=NativeGameplayObject(H,Path,true,C);auto* P=CastFieldChecked<FIntProperty>(NativeGameplayProperty(O,Path,Name,true,TEXT("int"),C));P->SetPropertyValue_InContainer(O,Value);}
