
int32 AuthoredGetbyte(const FDasObjectHandle& H,const char* Id,const char* Name,das::Context* C){auto* O=ResolveAuthoredObject(H,Id,C);auto* P=ResolveProperty<FByteProperty>(O,Name,false,C);if(P->Enum)C->throw_error("expected raw byte");return P->GetPropertyValue_InContainer(O);}
void AuthoredSetbyte(const FDasObjectHandle& H,const char* Id,const char* Name,int32 V,das::Context* C){if(ActiveContext && ActiveContext->bCollectingSubscriptions)C->throw_error("object writes are forbidden in bind_events");auto* O=ResolveAuthoredObject(H,Id,C);auto* P=ResolveProperty<FByteProperty>(O,Name,true,C);if(P->Enum || V<0 || V>255)C->throw_error("byte must be 0..255");P->SetPropertyValue_InContainer(O,uint8(V));}
FDasTextValue AuthoredGettext(const FDasObjectHandle& H,const char* Id,const char* Name,das::Context* C){auto* O=ResolveAuthoredObject(H,Id,C);return MakeDSLText(ResolveProperty<FTextProperty>(O,Name,false,C)->GetPropertyValue_InContainer(O),C);}
void AuthoredSettext(const FDasObjectHandle& H,const char* Id,const char* Name,FDasTextValue V,das::Context* C){if(ActiveContext && ActiveContext->bCollectingSubscriptions)C->throw_error("object writes are forbidden in bind_events");auto* O=ResolveAuthoredObject(H,Id,C);ResolveProperty<FTextProperty>(O,Name,true,C)->SetPropertyValue_InContainer(O,ResolveDSLText(V,C));}
uint8 GetSelfByte(const char* N,das::Context* C){auto* O=ResolveSelf(C);auto* P=ResolveProperty<FByteProperty>(O,N,false,C);if(P->Enum)C->throw_error("expected raw byte");return P->GetPropertyValue_InContainer(O);}
void SetSelfByte(const char* N,uint8 V,das::Context* C){if(ActiveContext && ActiveContext->bCollectingSubscriptions)C->throw_error("object writes are forbidden in bind_events");auto* O=ResolveSelf(C);auto* P=ResolveProperty<FByteProperty>(O,N,true,C);if(P->Enum)C->throw_error("expected raw byte");P->SetPropertyValue_InContainer(O,V);}
FDasTextValue GetSelfText(const char* N,das::Context* C){auto* O=ResolveSelf(C);return MakeDSLText(ResolveProperty<FTextProperty>(O,N,false,C)->GetPropertyValue_InContainer(O),C);}
void SetSelfText(const char* N,FDasTextValue V,das::Context* C){if(ActiveContext && ActiveContext->bCollectingSubscriptions)C->throw_error("object writes are forbidden in bind_events");auto* O=ResolveSelf(C);ResolveProperty<FTextProperty>(O,N,true,C)->SetPropertyValue_InContainer(O,ResolveDSLText(V,C));}
uint8 StructGetbyte(const FDasStructValue& H,const char* Path,das::Context* C){FInstancedStruct V=ResolveStructValue(H,C);auto F=StructLeaf(V,Path,C);auto* P=CastField<FByteProperty>(F.Property);if(!P || P->Enum)C->throw_error("expected raw byte struct leaf");return P->GetPropertyValue(F.Memory);}
FDasStructValue StructWithbyte(const FDasStructValue& H,const char* Path,uint8 X,das::Context* C,das::LineInfoArg* At){FInstancedStruct V=ResolveStructValue(H,C);auto F=StructLeaf(V,Path,C);auto* P=CastField<FByteProperty>(F.Property);if(!P || P->Enum)C->throw_error("expected raw byte struct leaf");P->SetPropertyValue(F.Memory,X);return StoreStructValue(V,C,At);}
FDasTextValue StructGettext(const FDasStructValue& H,const char* Path,das::Context* C){FInstancedStruct V=ResolveStructValue(H,C);auto F=StructLeaf(V,Path,C);auto* P=CastField<FTextProperty>(F.Property);if(!P)C->throw_error("expected text struct leaf");return MakeDSLText(P->GetPropertyValue(F.Memory),C);}
FDasStructValue StructWithtext(const FDasStructValue& H,const char* Path,FDasTextValue X,das::Context* C,das::LineInfoArg* At){FInstancedStruct V=ResolveStructValue(H,C);auto F=StructLeaf(V,Path,C);auto* P=CastField<FTextProperty>(F.Property);if(!P)C->throw_error("expected text struct leaf");P->SetPropertyValue(F.Memory,ResolveDSLText(X,C));return StoreStructValue(V,C,At);}
void PublishFrameByte(int32 I,uint8 X,das::Context* C){FDasScalarValue V;V.Kind=17;V.ByteValue=X;PublishFrameValue(I,MoveTemp(V),C);}
void PublishFrameText(int32 I,FDasTextValue X,das::Context* C){FDasScalarValue V;V.Kind=18;V.TextValue=ResolveDSLText(X,C);PublishFrameValue(I,MoveTemp(V),C);}
