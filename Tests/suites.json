{
  "comment": "Regression suites for Scripts/RunDasTests.ps1. Suites run in this order; 'requires' pulls in prerequisites unless -NoDependencies is given (then their probe files from an earlier run are used).",
  "suites": [
    { "name": "build", "kind": "build", "log": "combined-editor-build" },
    { "name": "runtime-isolation", "kind": "script", "script": "TestRuntimeIsolation.ps1", "comment": "Build ordinary game without test probes and inspect UHT/build inputs." },
    { "name": "probe-game-build", "kind": "script", "script": "TestProbeGameBuild.ps1", "comment": "Non-editor smoke game links test probes through explicit opt-in." },
    { "name": "script-staging", "kind": "script", "script": "TestScriptStaging.ps1", "requires": ["build"], "comment": "Actual C# selector, dependencies and UBT receipt." },
    { "name": "ue-aot", "kind": "script", "script": "TestUEAot.ps1", "requires": ["build"] },
    { "name": "gas-merge-regression", "kind": "script", "script": "TestGASMergeRegression.ps1" },
    { "name": "gas-foundation", "kind": "script", "script": "TestGAS.ps1" },
    { "name": "gas-authoring", "kind": "script", "script": "TestGASAuthored.ps1" },
    { "name": "gas-scripted-hooks", "kind": "script", "script": "TestGASHooks.ps1" },
    { "name": "gas-advanced", "kind": "script", "script": "TestGASAdvanced.ps1" },
    { "name": "gas-targeting", "kind": "script", "script": "TestGASTargeting.ps1" },
    { "name": "gas-ability-shipping", "kind": "script", "script": "TestGASAbilityShipping.ps1" },
    { "name": "gas-ability-packaged", "kind": "script", "script": "TestGASAbilityPackaged.ps1" },
    { "name": "gas-ability-pie", "kind": "automation", "test": "DasForUE.GAS.AbilityPlaygroundPIE", "log": "gas-ability-pie",
      "minimum": 1, "rendering": true, "marker": "DAS_GAS_ABILITY_PIE_RESULT=PASS" },
    { "name": "gas-ability-playground", "kind": "commandlet", "run": "DasGASAbilityPlayground", "log": "gas-ability-playground-runtime",
      "marker": "DAS_GAS_ABILITY_PLAYGROUND_RESULT=PASS", "rendering": true },
    { "name": "gas-cue-playground", "kind": "commandlet", "run": "DasGASCuePlayground", "log": "gas-cue-playground-runtime",
      "marker": "DAS_GAS_CUE_PLAYGROUND_RESULT=PASS", "rendering": true },
    { "name": "gas-native-generate", "kind": "script", "script": "GenerateNativeGameplay.ps1" },
    { "name": "gas-execution", "kind": "commandlet", "run": "DasGASExecution", "log": "gas-execution-runtime",
      "marker": "DAS_GAS_EXECUTION_RESULT=PASS" },
    { "name": "gas-cue-hooks", "kind": "commandlet", "run": "DasGASCueHooks", "log": "gas-cue-hooks-runtime",
      "marker": "DAS_GAS_CUE_HOOKS_RESULT=PASS" },
    { "name": "gas-cue-assets", "kind": "commandlet", "run": "DasGASCueAssets", "log": "gas-cue-assets-runtime",
      "marker": "DAS_GAS_CUE_ASSETS_RESULT=PASS" },
    { "name": "gas-cues", "kind": "commandlet", "run": "DasGASCues", "log": "gas-cues-runtime",
      "marker": "DAS_GAS_CUES_RESULT=PASS" },
    { "name": "python", "kind": "python", "log": "combined-python-tests" },
    { "name": "foundation", "kind": "commandlet", "run": "DasSmoke", "log": "combined-editor-foundation",
      "marker": "DAS_FOUNDATION_RESULT=PASS failures=0" },
    { "name": "components-prepare", "kind": "automation", "test": "DasForUE.Components.DynamicPIE",
      "log": "combined-components-prepare", "minimum": 1,
      "comment": "ClassReload loads assets that DynamicPIE saves in an earlier process." },
    { "name": "method-values", "kind": "phases", "run": "DasMethodValues", "log": "combined-method-values",
      "marker": "DAS_METHOD_VALUES_RESULT=PASS", "phases": ["Create", "Reopen"],
      "probe": "combined-method-values-probe-id.txt" },
    { "name": "automation", "kind": "automation", "test": "DasForUE", "log": "combined-all-automation", "minimum": 37,
      "requires": ["components-prepare", "method-values"], "probeArgs": { "DasMethodValuesProbeId": "method-values" } },
    { "name": "automation-quick", "kind": "automation", "log": "quick-automation", "minimum": 36,
      "comment": "Every DasForUE automation group except MethodValues.PIE, which needs the method-values assets.",
      "test": "DasForUE.ActorComponent+DasForUE.Actors+DasForUE.Callbacks+DasForUE.Components+DasForUE.Defaults+DasForUE.Delegates+DasForUE.DSL+DasForUE.FunctionLibraries+DasForUE.Gameplay+DasForUE.Lifecycle+DasForUE.MethodDispatch+DasForUE.Objects+DasForUE.Reload+DasForUE.SoftReferences+DasForUE.Types",
      "requires": ["components-prepare"] },
    { "name": "actor-component", "kind": "automation", "test": "DasForUE.ActorComponent", "log": "actor-component-automation",
      "minimum": 3, "comment": "Composed actors: PIE lifecycle and declaration reimport in the editor and during PIE." },
    { "name": "actor-component-assets", "kind": "script", "script": "TestActorComponent.ps1",
      "comment": "DasActorComponent commandlet: composition import checks, saved assets, Create and Reopen phases." },
    { "name": "reload-matrix", "kind": "automation", "test": "DasForUE.ReloadMatrix", "log": "reload-matrix",
      "minimum": 4, "comment": "Every declaration change of every entity kind, editor and PIE, against Tests/ReloadMatrix/expected.json." },
    { "name": "gameplay-pie", "kind": "automation", "test": "DasForUE.Gameplay.RuntimePIE", "log": "gameplay-pie",
      "minimum": 1, "comment": "Playable character, native references and their informational benchmark." },
    { "name": "performance", "kind": "script", "script": "TestPerformance.ps1",
      "comment": "Informational benchmark (DasPerformance commandlet); writes logs/performance-editor.json." },
    { "name": "native-defaults", "kind": "script", "script": "TestNativeDefaults.ps1",
      "probe": "native-defaults-probe-id.txt" },
    { "name": "defaults-merge", "kind": "script", "script": "TestDefaultsMerge.ps1",
      "comment": "PreserveOverrides merge: Create, Reopen, Recompile, Unopened phases (packaged run only with -Package)." },
    { "name": "computed-defaults", "kind": "script", "script": "TestComputedDefaults.ps1",
      "probe": "computed-defaults-probe-id.txt" },
    { "name": "gameplay-tags", "kind": "script", "script": "TestGameplayTags.ps1",
      "comment": "GameplayTag fields, map values, VM values and the dictionary checks behind the tag adapter." },
    { "name": "execution-roles", "kind": "script", "script": "TestExecutionRoles.ps1",
      "comment": "PhysicsPreSim role and frozen game-thread extern guard, sync and fixed-async." },
    { "name": "dsl-enum-names", "kind": "script", "script": "TestEnumNames.ps1" },
    { "name": "dsl-operation-keys", "kind": "script", "script": "TestOperationKeys.ps1" },
    { "name": "delegate-values", "kind": "phases", "run": "DasDelegate", "log": "handler-delegate-values",
      "marker": "DAS_AUTHORED_DELEGATES_RESULT=PASS", "phases": ["Create", "Reopen"],
      "probe": "handler-delegate-values-probe-id.txt" },
    { "name": "dsl-inherited-handlers", "kind": "script", "script": "TestInheritedHandlers.ps1" },
    { "name": "dsl-hidden-callbacks", "kind": "script", "script": "TestHiddenCallbacks.ps1" },
    { "name": "dsl-handler-references", "kind": "script", "script": "TestHandlerReferences.ps1" },
    { "name": "dsl-event-checks", "kind": "script", "script": "TestEventChecks.ps1" },
    { "name": "dsl-inline-callbacks", "kind": "script", "script": "TestInlineCallbacks.ps1" },
    {"name": "dsl-widget-layouts", "kind": "script", "script": "TestWidgetLayouts.ps1"},
    {"name": "dsl-reflection-macros", "kind": "script", "script": "TestReflectionMacros.ps1"},
    {"name": "dsl-identity", "kind": "script", "script": "TestIdentityDSL.ps1"},
    { "name": "packaged", "kind": "packaged", "log": "combined-export",
      "requires": ["method-values", "native-defaults", "computed-defaults"],
      "maps": [
        { "name": "gameplay", "map": "/Game/DasCookedGameplay/{export}/Map", "switch": "-DasCookedGameplay",
          "marker": "DAS_COOKED_GAMEPLAY_RESULT=PASS" },
        { "name": "playable", "map": "/Game/DasCookedGameplay/{export}/PlayableMap", "switch": "-DasPlayableMap",
          "marker": "DAS_PLAYABLE_MAP_RESULT=PASS" },
        { "name": "native", "map": "/Game/DasNativeDefaults/{native-defaults}/Map", "switch": "-DasNativeDefaults",
          "marker": "DAS_NATIVE_DEFAULTS_PACKAGED=PASS" },
        { "name": "computed", "map": "/Game/DasComputedDefaults/{computed-defaults}/Map",
          "switch": "-DasComputedDefaults", "marker": "DAS_COMPUTED_DEFAULTS_PACKAGED=PASS" },
        { "name": "method-values", "map": "/Game/DasMethodValues/{method-values}/Map", "switch": "-DasMethodValues",
          "marker": "DAS_METHOD_VALUES_RESULT=PASS" }
      ] }
  ],
  "presets": {
    "quick": ["build", "python", "foundation", "automation-quick"],
    "editor": ["build", "python", "foundation", "automation"],
    "full": ["build", "python", "foundation", "automation", "packaged"]
  }
}
