root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,inl,cs}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.das]
indent_style = space
indent_size = 4

[*.{ps1,py}]
indent_style = space
indent_size = 4

[*.{json,md}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
