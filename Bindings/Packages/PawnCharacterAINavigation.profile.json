    {
      "class": "/Script/AIModule.AIBlueprintHelperLibrary",
      "prefix": "ue_ai_helpers_",
      "include": [
        "*"
      ]
    }
  ],
  "receivers": [
    {
      "class": "/Script/Engine.Pawn",
      "prefix": "ue_pawn_",
      "include": [
        "*"
      ]
    },
    {
      "class": "/Script/Engine.Character",
      "prefix": "ue_character_",
      "include": [
        "*"
      ]
    },
    {
      "class": "/Script/Engine.Controller",
      "prefix": "ue_controller_",
      "include": [
        "*"
      ]
    },
    {
      "class": "/Script/Engine.PlayerController",
      "prefix": "ue_player_",
      "include": [
        "*"
      ]
    },
    {
      "class": "/Script/Engine.PawnMovementComponent",
      "prefix": "ue_pawn_move_",
      "include": [
        "*"
      ]
    },
    {
      "class": "/Script/Engine.NavMovementComponent",
      "prefix": "ue_nav_move_",
      "include": [
        "*"
      ]
    },
    {
      "class": "/Script/Engine.CharacterMovementComponent",
      "prefix": "ue_character_move_",
      "include": [
