      ]
    },
    {
      "class": "/Script/AIModule.AIPerceptionComponent",
      "prefix": "ue_perception_",
      "include": [
        "*"
      ]
    },
    {
      "class": "/Script/NavigationSystem.NavigationSystemV1",
      "prefix": "ue_navigation_",
      "include": [
        "*"
      ]
    },
    {
      "class": "/Script/NavigationSystem.NavigationPath",
      "prefix": "ue_path_",
      "include": [
        "*"
      ]
    }
  ],
  "exclusions": [
    {
      "class": "/Script/AIModule.AIBlueprintHelperLibrary",
      "function": "CreateMoveToProxyObject",
      "reason": "Use the lifecycle-managed ue_ai MoveTo adapter; raw async proxy callbacks and ownership are outside the generic call contract."
    }
  ],
  "probe_world": true,
  "probe": "[export]\ndef main(input:int):int {\n    verify(ue_ai_helpers_IsValidAILocation(ue_vector(0.0lf,0.0lf,0.0lf)),\"valid AI location\")\n    verify(ue_ai_helpers_IsValidAIDirection(ue_vector(1.0lf,0.0lf,0.0lf)),\"valid AI direction\")\n    verify(!ue_ai_helpers_IsValidAIDirection(ue_vector(0.0lf,0.0lf,0.0lf)),\"zero AI direction\")\n    return 42\n}"
}
