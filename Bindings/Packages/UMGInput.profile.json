  "probe_world": true,
  "probe": "[export]\ndef main(input:int):int {\n    let button=ue_input_value(true)\n    verify(ue_input_type(button)==InputValueType.Boolean && ue_input_bool(button),\"bool\")\n    let axis=ue_input_value(-0.5)\n    verify(ue_input_type(axis)==InputValueType.Axis1D && ue_input_axis1d(axis)==-0.5lf,\"axis1d\")\n    let move=ue_input_value(ue_vector2d(3.0lf,4.0lf))\n    let xy=ue_input_axis2d(move)\n    verify(ue_input_type(move)==InputValueType.Axis2D && xy.x==3.0lf && xy.y==4.0lf,\"axis2d\")\n    let look=ue_input_value(ue_vector(1.0lf,2.0lf,3.0lf))\n    verify(ue_input_type(look)==InputValueType.Axis3D && ue_input_axis3d(look).z==3.0lf,\"axis3d\")\n    let parts=ue_enhanced_api_BreakInputActionValue(move)\n    verify(parts.out_x==3.0lf && parts.out_y==4.0lf && parts.out_z==0.0lf,\"native break\")\n    let made=ue_enhanced_api_MakeInputActionValueOfType(7.0lf,8.0lf,9.0lf,E_EInputActionValueType_9254fc67.v_Axis1D)\n    let xyz=ue_input_axis3d(made)\n    verify(ue_input_type(made)==InputValueType.Axis1D && xyz.x==7.0lf && xyz.y==0.0lf && xyz.z==0.0lf,\"native make clears unused axes\")\n    verify(ue_enhanced_api_Conv_InputActionValueToString(button)==\"true\",\"native string\")\n    var copies:array<InputActionValue>\n    push(copies,move)\n    verify(ue_input_axis2d(copies[0]).y==4.0lf,\"owned container copy\")\n    return 42\n}"
